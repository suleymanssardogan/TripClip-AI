# ── Veritabanı ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tripclip:tripclip123@localhost:5432/tripclip

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MongoDB (Qdrant değil, opsiyonel log/metadata için) ──────────────────────
MONGODB_URL=mongodb://localhost:27017/tripclip

# ── JWT ──────────────────────────────────────────────────────────────────────
# Güçlü, rastgele bir secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_a_strong_random_secret_here

# ── Google Cloud Vision ───────────────────────────────────────────────────────
# JSON anahtar dosyasının yolu (Docker içinde /app/credentials/tripclip-ai.json)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/tripclip-ai.json

# ── Upload dizini ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads/videos

# ── Sentry (opsiyonel — production hata takibi) ───────────────────────────────
# Boş bırakılırsa Sentry devre dışı kalır
SENTRY_DSN=
SENTRY_TRACES_RATE=1.0

# ── Password Reset E-postası (SMTP, opsiyonel) ─────────────────────────────────
# SMTP_HOST eksikse şifre sıfırlama e-postası sessizce gönderilmez (bkz.
# app/infrastructure/email/email_service.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@tripclip.app
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Google Sign-In (OAuth 2.0, opsiyonel) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/google/callback,com.sardogan.TripClipAI:/oauth2redirect
