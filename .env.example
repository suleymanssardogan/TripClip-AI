# TripClip AI — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ── Required: Secrets (generate with scripts/generate-secrets.sh) ─────────────
JWT_SECRET_KEY=

# ── Required: Google Gemini API ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Required in production: Database passwords ────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Database (defaults are fine for most deployments) ─────────────────────────
POSTGRES_USER=tripclip
POSTGRES_DB=tripclip

# ── Web Frontend ─────────────────────────────────────────────────────────────
# Use /api/web when served behind nginx on the same domain.
NEXT_PUBLIC_API_URL=/api/web

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable startup secret validation and harden security.
APP_ENV=production

# ── CORS (comma-separated, leave empty for service defaults) ──────────────────
ALLOWED_ORIGINS=

# ── AI Pipeline ───────────────────────────────────────────────────────────────
USE_GEMINI=true
USE_HYBRID=true
WHISPER_MODEL=base
USE_GOOGLE_VISION=false

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
