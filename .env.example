# TripClip AI — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ── Required: Secrets (generate with scripts/generate-secrets.sh) ─────────────
JWT_SECRET_KEY=
# BFF ↔ core-api arası paylaşılan sır — network izolasyonunun ötesinde ikinci
# bir savunma katmanı (core-api'nin /internal/* route'ları bunu doğrular).
# Boş bırakılırsa doğrulama atlanır (local geliştirme için güvenli varsayılan).
INTERNAL_API_SECRET=

# ── Required: Google Gemini API ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Required in production: Database passwords ────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Required in production: Grafana admin şifresi ─────────────────────────────
# Grafana/Prometheus public'e açık değil (127.0.0.1'e bağlı, SSH tünel ile
# erişilir) ama admin şifresi yine de varsayılan bırakılmamalı.
GRAFANA_ADMIN_PASSWORD=

# ── Database (defaults are fine for most deployments) ─────────────────────────
POSTGRES_USER=tripclip
POSTGRES_DB=tripclip

# ── Web Frontend ─────────────────────────────────────────────────────────────
# Use /api/web when served behind nginx on the same domain.
NEXT_PUBLIC_API_URL=/api/web

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable startup secret validation and harden security.
APP_ENV=production

# ── CORS (comma-separated, leave empty for service defaults) ──────────────────
ALLOWED_ORIGINS=

# ── Trusted hosts (comma-separated, leave empty for "*" / no restriction) ─────
# Set to your production domain(s) to harden web-bff/mobile-bff against
# Host-header attacks, e.g.: ALLOWED_HOSTS=tripclip.app,www.tripclip.app
ALLOWED_HOSTS=

# ── AI Pipeline ───────────────────────────────────────────────────────────────
USE_GEMINI=true
USE_HYBRID=true
WHISPER_MODEL=small
USE_GOOGLE_VISION=false

# Kullanıcı başına günlük video işleme limiti — USE_GEMINI=true modunda her
# video en az 2 Gemini API çağrısı tüketir; script'lenmiş bir hesabın maliyeti
# sınırsız büyütmesini önler. Redis erişilemezse kota fail-open davranır.
DAILY_UPLOAD_QUOTA_PER_USER=20

# ── Travel Tips RAG + Trip Assistant local provider (optional) ────────────────
# Ollama is NOT part of the Docker stack. Leave OLLAMA_URL empty to disable
# travel-tips generation (the pipeline degrades gracefully — every other
# stage still runs). To enable it, point OLLAMA_URL at an Ollama instance you
# run yourself (e.g. http://host.docker.internal:11434 for a local Ollama on
# Docker Desktop, or a reachable host on Linux).
OLLAMA_URL=
OLLAMA_MODEL=mistral

# Trip Assistant sağlayıcısı: "gemini" (varsayılan) | "ollama". "ollama"
# seçilirse yukarıdaki OLLAMA_URL/OLLAMA_MODEL kullanılır — Ollama
# ayarlanmamışsa asistan güvenle devre dışı kalır (bkz. docs/trip-assistant.md).
AI_ASSISTANT_PROVIDER=gemini

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Push Notifications (APNs, optional) ────────────────────────────────────────
# Video işlendiğinde/başarısız olduğunda kullanıcıya bildirim gönderir. Herhangi
# biri eksikse push sessizce devre dışı kalır — pipeline'ı etkilemez.
# Key ID + .p8 dosyası: Apple Developer > Certificates, Identifiers & Profiles > Keys.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# .p8 dosyasının içeriği tek satırda, satır sonları \n olarak kaçışlı:
#   APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APNS_AUTH_KEY=
# TestFlight/development build'ler için true, App Store için false.
APNS_USE_SANDBOX=true

# ── Shared-Trip Analytics (optional) ───────────────────────────────────────────
# Weeks 19-20 büyüme hunisi event'leri — bkz. docs/shared-trip-analytics.md.
# false yapılırsa tüm event yazımı deploy gerektirmeden durur.
ANALYTICS_ENABLED=true

# ── Password Reset E-postası (SMTP, optional) ──────────────────────────────────
# Herhangi biri eksikse (özellikle SMTP_HOST) şifre sıfırlama e-postası
# SESSİZCE gönderilmez — /forgot-password endpoint'i yine de her zaman aynı
# genel yanıtı döner (bkz. docs/auth.md "Password reset"), pipeline/deploy
# BOZULMAZ. Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, bir "uygulama
# şifresi" ile SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@tripclip.app
# Sıfırlama linkinin işaret ettiği Web sayfası (core-api hiçbir HTML render
# ETMEZ, yalnızca linki kurar) ve linkin geçerlilik süresi.
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Google Sign-In (OAuth 2.0, optional) ───────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials'ta bir "OAuth 2.0
# Client ID" (Web application türü) oluşturun. GOOGLE_CLIENT_ID PUBLIC'tir
# (Web/iOS istemcisine gömülür, gizli DEĞİLDİR) — GOOGLE_CLIENT_SECRET ise
# YALNIZCA core-api'de kalır, hiçbir istemciye GÖNDERİLMEZ. Herhangi biri
# eksikse Google Sign-In güvenle devre dışı kalır (GOOGLE_AUTH_UNAVAILABLE).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İzin verilen redirect_uri'lerin virgülle ayrılmış listesi — istemcinin
# bildirdiği redirect_uri BUNLARDAN biri değilse istek reddedilir (bkz.
# docs/auth.md "Google OAuth — redirect_uri allowlist").
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/google/callback,com.sardogan.TripClipAI:/oauth2redirect
